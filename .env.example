# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local al repositorio,
# y nunca pegues un valor real en un chat.
#
# En producción (DigitalOcean) estas variables las define .do/app.yaml; los secretos se escriben
# cifrados en el panel de DigitalOcean (docs/09 §5.0.1).

# Base de datos. En local: npm run db:local
DATABASE_URL=postgres://postgres:local@127.0.0.1:5433/refuva
# Solo en producción: el CA de la base gestionada, para verificar el SSL (${db.CA_CERT}).
DATABASE_CA_CERT=

# Firma las sesiones del panel. En local, cualquier texto largo; en producción, aleatorio y fijo.
PAYLOAD_SECRET=

# Dirección pública del sitio (sin barra final).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Avisos por correo. Sin RESEND_API_KEY, los correos se escriben en la consola.
AVISOS_CORREO=
RESEND_API_KEY=
CORREO_REMITENTE=avisos@refuva.org
